export interface TrackPoint {
  distance: number; // cumulative distance in meters
  elevation: number; // elevation in meters
  latitude?: number;
  longitude?: number;
  timestamp?: number;
}

export interface Activity {
  id: string;
  date: string;
  routeName: string;
  distance: number; // km
  duration: string; // hh:mm:ss
  elevation: number; // meters
  trackData?: TrackPoint[]; // optional elevation profile data
}

// Generate sample elevation profile data for a hilly route
function generateElevationProfile(distanceKm: number, points: number = 100): TrackPoint[] {
  const profile: TrackPoint[] = [];
  let elevation = 100;

  for (let i = 0; i <= points; i++) {
    const distance = (i / points) * distanceKm * 1000; // convert to meters
    const progress = i / points;

    // Create interesting elevation profile with climbs and descents
    const climb1 = Math.sin(progress * Math.PI) * 300; // First big climb
    const climb2 = Math.sin((progress - 0.5) * Math.PI) * 200; // Second climb
    const descent = Math.sin(progress * Math.PI * 2) * 50; // Small undulations

    elevation = 150 + climb1 + climb2 + descent;
    elevation = Math.max(50, Math.min(800, elevation)); // Clamp between 50-800m

    profile.push({
      distance,
      elevation: Math.round(elevation),
      timestamp: i * 60000, // 1 minute intervals
    });
  }

  return profile;
}

